// ============================================================================
// Medidas DAX — Cruzamento ANP 2020–2025 (Produção x Importação x Exportação)
// ============================================================================
// Criar as medidas na tabela FatoMensal (ou numa tabela dedicada "Medidas").
// Requer: relação Calendario[Data] -> FatoMensal[DATA] (1:*, direção única).
// Formatação sugerida indicada em comentário ao final de cada medida.
// ============================================================================

// ---------------------------- VOLUMES (BARRIS) ------------------------------
Produção (bi bbl) =
DIVIDE ( SUM ( FatoMensal[PRODUCAO_BARRIS] ), 1000000000 )
// Formato: número decimal, 2 casas

Exportação (bi bbl) =
DIVIDE ( SUM ( FatoMensal[EXPORTACAO_BARRIS] ), 1000000000 )
// Formato: número decimal, 2 casas

Importação (bi bbl) =
DIVIDE ( SUM ( FatoMensal[IMPORTACAO_BARRIS] ), 1000000000 )
// Formato: número decimal, 2 casas

Balança Comercial (bi bbl) =
DIVIDE (
    SUM ( FatoMensal[BALANCA_COMERCIAL_BARRIS] ),
    1000000000
)
// Formato: número decimal, 2 casas

// ------------------------- INDICADORES DE CRUZAMENTO ------------------------
Cobertura Exportação % =
DIVIDE (
    SUM ( FatoMensal[EXPORTACAO_BARRIS] ),
    SUM ( FatoMensal[PRODUCAO_BARRIS] )
)
// Formato: porcentagem, 1 casa — % da produção que foi exportada

Dependência Importação % =
DIVIDE (
    SUM ( FatoMensal[IMPORTACAO_BARRIS] ),
    SUM ( FatoMensal[PRODUCAO_BARRIS] )
)
// Formato: porcentagem, 1 casa — importações em relação à produção nacional

Produção Média (bbl/dia) =
AVERAGEX (
    VALUES ( FatoMensal[DATA] ),
    DIVIDE (
        CALCULATE ( SUM ( FatoMensal[PRODUCAO_BARRIS] ) ),
        DAY ( EOMONTH ( MAX ( FatoMensal[DATA] ), 0 ) )
    )
)
// Formato: número inteiro com milhar — média ponderada de barris/dia no período

// -------------------------------- TIME INTELLIGENCE -------------------------
Produção Ano Anterior =
CALCULATE ( [Produção (bi bbl)], SAMEPERIODLASTYEAR ( Calendario[Data] ) )

Variação YoY Produção % =
DIVIDE ( [Produção (bi bbl)] - [Produção Ano Anterior], [Produção Ano Anterior] )
// Formato: porcentagem, 1 casa

Exportação Ano Anterior =
CALCULATE ( [Exportação (bi bbl)], SAMEPERIODLASTYEAR ( Calendario[Data] ) )

Variação YoY Exportação % =
DIVIDE ( [Exportação (bi bbl)] - [Exportação Ano Anterior], [Exportação Ano Anterior] )
// Formato: porcentagem, 1 casa

Importação Ano Anterior =
CALCULATE ( [Importação (bi bbl)], SAMEPERIODLASTYEAR ( Calendario[Data] ) )

Variação YoY Importação % =
DIVIDE ( [Importação (bi bbl)] - [Importação Ano Anterior], [Importação Ano Anterior] )
// Formato: porcentagem, 1 casa

// -------------------- FASES CONTRATUAIS (DESENVOLVIMENTO) -------------------
// DimFasesCampos não tem relação física com o fato; propaga o contexto de ano
// via TREATAS (evita ambiguidade many-to-many).
Campos em Produção =
CALCULATE (
    MAX ( DimFasesCampos[CAMPOS_EM_PRODUCAO] ),
    TREATAS ( VALUES ( FatoMensal[ANO] ), DimFasesCampos[ANO] )
)
// Formato: número inteiro

Campos em Desenvolvimento =
CALCULATE (
    MAX ( DimFasesCampos[CAMPOS_EM_DESENVOLVIMENTO] ),
    TREATAS ( VALUES ( FatoMensal[ANO] ), DimFasesCampos[ANO] )
)
// Formato: número inteiro

Produção Média por Campo (mi bbl/ano) =
VAR Campos = [Campos em Produção]
RETURN DIVIDE ( SUM ( FatoMensal[PRODUCAO_BARRIS] ), Campos * 1000000 )
// Formato: número decimal, 1 casa — produtividade média anual por campo ativo
