# =============================================================================
# SISTEMA DE APURAÇÃO DE RENTABILIDADE - CONFIGURAÇÃO DE AMBIENTE
# Arquivo modelo para variáveis de ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# NUNCA commite o arquivo .env com credenciais reais no GitHub!
# =============================================================================

# Servidor do SQL Server (ex: localhost, 192.168.1.10 ou nome da instancia)
DB_SERVER=localhost

# Nome do banco de dados (criado previamente no SQL Server)
DB_DATABASE=DB_RENTABILIDADE

# Usuário SQL Server (autenticação SQL Server)
DB_UID=sa

# Senha do usuário SQL Server
DB_PWD=SuaSenhaForte@123

# Porta do SQL Server (padrão: 1433)
DB_PORT=1433

# Driver ODBC (não alterar salvo necessidade específica)
DB_DRIVER=ODBC Driver 17 for SQL Server

# Opcional: Timeout de conexão em segundos
DB_TIMEOUT=30

# Opcional: Criptografia da conexão (yes/no) - recomendado 'yes' em produção
DB_ENCRYPT=yes

# Opcional: Confiar no certificado do servidor (yes/no)
DB_TRUST_CERT=yes
